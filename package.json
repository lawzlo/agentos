{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentos": "./dist/bin/agentos.js"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "npm run build:ts && node dist/src/index.js",
    "test": "npm run build:ts && node scripts/run-tests.mjs",
    "build:ts": "node scripts/build-ts.mjs",
    "cli:link": "npm run build:ts && npm link",
    "cli:unlink": "npm unlink -g agentos",
    "typecheck": "tsc --noEmit",
    "native:build": "cargo build --manifest-path rust/agentos-native/Cargo.toml --release",
    "package:release": "node scripts/package-release.mjs",
    "package:macos": "node scripts/build-macos-pkg.mjs",
    "package:windows": "node scripts/build-windows-msi.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.54.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
